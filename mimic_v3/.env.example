# MIMIC V3.1 Environment Configuration
# Copy this file to .env and fill in your values

# ===========================================
# KALSHI API CREDENTIALS
# Get these from: https://kalshi.com/api
# ===========================================
KALSHI_API_KEY=your_kalshi_api_key_here
KALSHI_API_SECRET=your_kalshi_api_secret_here

# ===========================================
# PERPLEXITY API (for News Oracle)
# Get from: https://perplexity.ai/api
# ===========================================
PERPLEXITY_API_KEY=your_perplexity_api_key_here

# ===========================================
# ENVIRONMENT SETTINGS
# ===========================================
# PRODUCTION or DEVELOPMENT
ENV=DEVELOPMENT

# Enable demo mode (uses Kalshi demo API)
DEMO_MODE=true

# Enable paper trading (no real orders)
PAPER_TRADING=true

# ===========================================
# RISK PARAMETERS
# ===========================================
INITIAL_CAPITAL=1000.00
MAX_DAILY_LOSS=50.00
MAX_WEEKLY_LOSS=150.00
KELLY_FRACTION=0.25

# ===========================================
# SCANNER SETTINGS
# ===========================================
WHALE_VOLUME_THRESHOLD=500.00
RESOLUTION_WINDOW_HOURS=2.0

# ===========================================
# MAKER SETTINGS
# ===========================================
MAX_INVENTORY_PER_MARKET=100
MAX_TOTAL_INVENTORY=500
MIN_SPREAD_BPS=200

# ===========================================
# LOGGING
# ===========================================
LOG_LEVEL=INFO
LOG_FILE=logs/mimic_cortex.log
