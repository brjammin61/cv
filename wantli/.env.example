# Backend API URL
# IMPORTANT: Replace YOUR_COMPUTER_IP with your actual local IP address
# Don't use 'localhost' - it won't work on your phone!
# Find your IP: Mac/Linux: ifconfig | Windows: ipconfig
EXPO_PUBLIC_API_URL=http://YOUR_COMPUTER_IP:3000/api

# Cloudinary (Image Uploads)
# Sign up at: https://cloudinary.com
EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name

# Stripe (Payments)
# Sign up at: https://stripe.com
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_key_here

# Pusher (Real-time Messaging)
# Sign up at: https://pusher.com
EXPO_PUBLIC_PUSHER_KEY=your_pusher_key
EXPO_PUBLIC_PUSHER_CLUSTER=us2
