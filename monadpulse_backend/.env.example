# MonadPulse Backend Environment Configuration
# Copy this file to .env and update with your values

# =============================================================================
# Database Configuration
# =============================================================================
POSTGRES_PASSWORD=monadpulse_secure_password_2024

# =============================================================================
# Application Configuration
# =============================================================================
# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# =============================================================================
# Ingestor Configuration
# =============================================================================
# How often to fetch and update data (in seconds)
UPDATE_INTERVAL_SECONDS=60

# =============================================================================
# Monad Network Configuration (for future real data integration)
# =============================================================================
# MONAD_RPC_URL=https://rpc.monad.xyz
# MONAD_CHAIN_ID=monad-1
# MONAD_API_KEY=your_api_key_here

# =============================================================================
# Production Settings
# =============================================================================
# Uncomment and update these for production deployment

# Strong database password
# POSTGRES_PASSWORD=<generate-strong-password>

# Production logging (less verbose)
# LOG_LEVEL=WARNING

# Longer update interval to reduce load
# UPDATE_INTERVAL_SECONDS=120
