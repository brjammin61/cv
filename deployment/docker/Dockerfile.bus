# ORE V2 Bus/Dispatcher Docker Image

FROM rust:1.75 as builder

WORKDIR /build

# Copy workspace files
COPY Cargo.toml ./
COPY crates ./crates

# Build release binary
RUN cargo build --release --bin ore-bus

# Runtime stage
FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y \
    ca-certificates \
    libssl3 \
    && rm -rf /var/lib/apt/lists/*

# Create app user
RUN useradd -m -u 1000 ore && \
    mkdir -p /app/logs && \
    chown -R ore:ore /app

USER ore
WORKDIR /app

# Copy binary from builder
COPY --from=builder /build/target/release/ore-bus /app/

# Expose Prometheus metrics port
EXPOSE 9090

ENTRYPOINT ["/app/ore-bus"]
