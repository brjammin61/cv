# ORE V2 Miner Worker Docker Image (GPU-enabled)

FROM nvidia/cuda:12.2.0-devel-ubuntu22.04 as builder

# Install Rust
RUN apt-get update && apt-get install -y \
    curl \
    build-essential \
    pkg-config \
    libssl-dev \
    && rm -rf /var/lib/apt/lists/*

RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y
ENV PATH="/root/.cargo/bin:${PATH}"

WORKDIR /build

# Copy workspace files
COPY Cargo.toml ./
COPY crates ./crates

# Build with CUDA support
ENV CUDA_PATH=/usr/local/cuda
RUN cargo build --release --bin ore-miner

# Runtime stage
FROM nvidia/cuda:12.2.0-runtime-ubuntu22.04

RUN apt-get update && apt-get install -y \
    ca-certificates \
    libssl3 \
    && rm -rf /var/lib/apt/lists/*

# Create app user
RUN useradd -m -u 1000 ore && \
    mkdir -p /app/logs && \
    chown -R ore:ore /app

USER ore
WORKDIR /app

# Copy binary from builder
COPY --from=builder /build/target/release/ore-miner /app/

ENTRYPOINT ["/app/ore-miner"]
