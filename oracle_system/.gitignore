# ============================================================================
# THE ORACLE - Git Ignore File
# ============================================================================

# ===== CRITICAL: API Keys and Secrets =====
config/api_keys.py
*.pem
*.key
*.env
.env.*
secrets/
credentials/

# ===== Python =====
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ===== Virtual Environments =====
venv/
ENV/
env/
.venv/

# ===== IDEs and Editors =====
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# ===== Jupyter Notebooks =====
.ipynb_checkpoints/
*.ipynb

# ===== Data and Logs =====
data/*.csv
data/*.json
data/*.db
data/*.sqlite
logs/*.log
logs/*.txt

# Allow example/template data
!data/README.md
!data/example_*.csv

# ===== Testing =====
.pytest_cache/
.coverage
htmlcov/
.tox/
.hypothesis/

# ===== Streamlit =====
.streamlit/secrets.toml

# ===== Database =====
*.db
*.sqlite
*.sqlite3

# ===== Temporary Files =====
*.tmp
*.bak
*.cache
.cache/

# ===== OS =====
Thumbs.db
desktop.ini

# ===== Custom Oracle Files =====
# Saved parameter configurations (may contain sensitive settings)
oracle_params_*.json

# Trade history (may contain PII or sensitive trading data)
trade_history/
positions/

# ===== Allow These =====
!.gitignore
!README.md
!requirements.txt
