# ORE Arbitrage Bot Configuration

# =============================================================================
# REQUIRED SETTINGS
# =============================================================================

# Solana RPC endpoint (CRITICAL: Use a private/premium RPC for production)
# Recommended providers: Helius, Triton, QuickNode, Alchemy
# Example: https://mainnet.helius-rpc.com/?api-key=YOUR_API_KEY
RPC_URL=https://api.mainnet-beta.solana.com

# Path to your Solana wallet keypair JSON file
# This wallet will be used for all transactions
# SECURITY: Keep this file secure and never commit it to git
WALLET_PATH=wallet.json

# =============================================================================
# TOKEN CONFIGURATION
# =============================================================================

# ORE token mint address
# Default: Official ORE token (verify this is correct!)
ORE_MINT=oreoU2P8bN6jkk3jbaiVxYnG1dCXcYxwhwyK9jSybcp

# SOL token mint address (wrapped SOL for Jupiter)
SOL_MINT=So11111111111111111111111111111111111111112

# =============================================================================
# MINER CONFIGURATION
# =============================================================================

# Path to the ORE miner executable
# Examples:
#   - "ore" (if installed globally)
#   - "./ore-cli" (if in current directory)
#   - "/usr/local/bin/ore-miner" (absolute path)
MINER_PATH=ore

# Arguments to pass to the miner
# Examples:
#   - "mine --keypair wallet.json"
#   - "mine --threads 4"
#   - "mine --priority-fee 10000"
MINER_ARGS=mine --keypair wallet.json

# Estimated compute units for a mining transaction
# This is used to calculate transaction costs
# Calibrate this based on your actual mining transactions
# Range: 100,000 - 400,000 (typical)
ESTIMATED_COMPUTE_UNITS=200000

# =============================================================================
# BOT BEHAVIOR
# =============================================================================

# Profit threshold percentage (e.g., 5.0 = 5%)
# The bot will only switch strategies if the profit margin exceeds this threshold
# Lower = more frequent switches, Higher = more stable but potentially less optimal
# Recommended: 3.0 - 10.0
PROFIT_THRESHOLD_PERCENT=5.0

# How often to check prices and make decisions (in seconds)
# Lower = more responsive but more API calls, Higher = less responsive but fewer calls
# Recommended: 15 - 60 seconds
POLL_INTERVAL_SECONDS=30

# =============================================================================
# SWAP CONFIGURATION
# =============================================================================

# Slippage tolerance in basis points (e.g., 50 = 0.5%)
# Higher slippage = more likely to execute but worse price
# Lower slippage = better price but may fail in volatile markets
# Recommended: 50 - 200 bps
SLIPPAGE_BPS=50

# Amount of SOL to swap per buy operation
# This is the amount of SOL that will be swapped for ORE each time the bot decides to BUY
# Adjust based on your capital and risk tolerance
# Example: 0.1 = swap 0.1 SOL for ORE each buy cycle
SWAP_AMOUNT_SOL=0.1

# Auto-execute swaps (true/false)
# SAFETY: Set to 'false' for testing to see what the bot would do without executing
# Set to 'true' for production to actually execute swaps
# IMPORTANT: Test thoroughly before setting to 'true'!
AUTO_EXECUTE_SWAPS=false

# =============================================================================
# LOGGING
# =============================================================================

# Logging level (trace, debug, info, warn, error)
# For production, use 'info' or 'warn'
# For debugging, use 'debug' or 'trace'
RUST_LOG=info

# =============================================================================
# SECURITY NOTES
# =============================================================================

# 1. NEVER commit your .env file to git (use .gitignore)
# 2. NEVER share your wallet keypair
# 3. Use a dedicated wallet with limited funds for testing
# 4. Always use a private RPC endpoint in production
# 5. Start with AUTO_EXECUTE_SWAPS=false and verify behavior
# 6. Monitor your bot's activity regularly
# 7. Set up alerts for unexpected behavior
# 8. Keep your software updated

# =============================================================================
# PERFORMANCE TUNING
# =============================================================================

# For optimal performance:
# 1. Use a premium RPC with low latency (< 50ms)
# 2. Deploy on a server close to RPC endpoint (e.g., same region)
# 3. Tune POLL_INTERVAL_SECONDS based on network conditions
# 4. Calibrate ESTIMATED_COMPUTE_UNITS from actual transactions
# 5. Monitor and adjust PROFIT_THRESHOLD_PERCENT based on results
