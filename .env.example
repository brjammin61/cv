# ORE V2 Dominance Bot - Environment Configuration
# Copy this file to .env and fill in your values

# === Network Configuration ===
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_WS_URL=wss://api.mainnet-beta.solana.com

# Jito Configuration
JITO_BLOCK_ENGINE_URL=https://mainnet.block-engine.jito.wtf/api/v1/bundles
JITO_TIP_ACCOUNT=96gYZGLnJYVFmbjzopPSU6QiEV5fGqZNyN9nmNhvrZU5

# === Redis Configuration ===
REDIS_URL=redis://127.0.0.1:6379

# === ORE V2 Program ===
ORE_GRID_PROGRAM_ID=ore1111111111111111111111111111111111111111

# === Wallet Configuration ===
# IMPORTANT: Use a fresh wallet, never reuse existing wallets
WALLET_PATH=./deployment/wallets/bot-wallet.json

# === Bot Configuration ===

# Maximum stake per round (in lamports, 1 SOL = 1,000,000,000)
MAX_STAKE_PER_ROUND=1000000000

# Enable mempool monitoring for Shadow Board
ENABLE_MEMPOOL_MONITORING=true

# === Miner Configuration ===
# GPU enabled (true/false)
ORE_MINER_GPU_ENABLED=true

# GPU device ID (0, 1, 2, etc.)
ORE_MINER_GPU_DEVICE_ID=0

# Target difficulty (higher = harder but better rewards)
ORE_MINER_TARGET_DIFFICULTY=12

# === Treasury Configuration ===
# Auto-stake rewards
TREASURY_AUTO_STAKE_ENABLED=true

# Target stake multiplier (max 2.0)
TREASURY_TARGET_MULTIPLIER=2.0

# Profit-taking threshold (ROI %)
TREASURY_PROFIT_TAKE_THRESHOLD=0.50

# Minimum SOL reserve for operations
TREASURY_RESERVE_SOL=100000000

# === Logging ===
RUST_LOG=info,ore_bus=debug,ore_strategist=debug

# === Monitoring ===
PROMETHEUS_PORT=9090
