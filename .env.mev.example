# MEV Bot - Production Configuration

## Core Settings

# RPC Configuration (CRITICAL - Use premium RPC!)
RPC_URL=https://api.mainnet-beta.solana.com
# Recommended: Triton, Helius, QuickNode for low latency

# Jito Block Engine (for MEV Level 3)
JITO_BLOCK_ENGINE_URL=https://mainnet.block-engine.jito.wtf
JITO_TIP_ACCOUNT=96gYZGLnJYVFmbjzopPSU6QiEV5fGqZNyN9nmNhvrZU5

# Wallet Configuration
WALLET_PATH=wallet.json

## Strategy Configuration

# Enable/disable different MEV strategies
ENABLE_CROSS_DEX_ARB=true        # Level 1
ENABLE_MULTI_HOP_ARB=true         # Level 2
ENABLE_MEV_SEARCHER=true          # Level 3

## Profit Thresholds (CRITICAL for profitability!)

# Minimum profit in SOL to execute arbitrage
MIN_PROFIT_SOL=0.001              # $0.10 at $100/SOL

# Minimum profit percentage (accounting for slippage + fees)
MIN_PROFIT_PERCENT=0.5            # 0.5% minimum after ALL costs

# Maximum slippage tolerance
MAX_SLIPPAGE_BPS=50               # 0.5% max slippage

## Fee Configuration (Built into profit calculations)

# Transaction fees
BASE_TX_FEE=0.000005              # 5000 lamports
PRIORITY_FEE_MICROLAMPORTS=10000  # Adjust based on network

# Protocol fees (varies by DEX)
JUPITER_FEE_BPS=0                 # Jupiter has no protocol fee
RAYDIUM_FEE_BPS=25                # 0.25%
ORCA_FEE_BPS=30                   # 0.30%

## Risk Management

# Maximum SOL to deploy per transaction
MAX_TRADE_SIZE_SOL=10.0

# Maximum total exposure across all positions
MAX_TOTAL_EXPOSURE_SOL=50.0

# Stop loss - pause bot if losses exceed this
MAX_DAILY_LOSS_SOL=1.0

## Performance Tuning

# How often to scan for opportunities (milliseconds)
SCAN_INTERVAL_MS=100              # Check every 100ms

# Number of concurrent opportunities to track
MAX_CONCURRENT_OPS=10

# Transaction timeout (seconds)
TX_TIMEOUT_SECONDS=30

## DEX Configuration

# DEX program IDs
JUPITER_PROGRAM_ID=JUP6LkbZbjS1jKKwapdHNy74zcZ3tLUZoi5QNyVTaV4
RAYDIUM_PROGRAM_ID=675kPX9MHTjS2zt1qfr1NYHuzeLXfQM9H24wFSUt1Mp8
ORCA_PROGRAM_ID=whirLbMiicVdio4qvUfM5KAg6Ct8VwpYzGff3uctyCc

# Token mints to monitor
TOKENS_TO_MONITOR=SOL,USDC,USDT,BONK,WIF,JTO,JUP,PYTH,RAY

## Monitoring & Alerts

# Enable profit/loss tracking
ENABLE_PNL_TRACKING=true

# Log level (trace, debug, info, warn, error)
RUST_LOG=info

# Alert webhook (optional - for Discord/Telegram)
ALERT_WEBHOOK_URL=

## Advanced Settings

# Use Jito bundles for Level 3 MEV
USE_JITO_BUNDLES=true

# Jito tip amount (lamports to tip for priority)
JITO_TIP_LAMPORTS=10000           # 0.00001 SOL tip

# Enable flash loans for larger arbitrage
ENABLE_FLASH_LOANS=false          # Set true when ready

# Compute unit limit
COMPUTE_UNIT_LIMIT=200000

# Compute unit price (micro-lamports per CU)
COMPUTE_UNIT_PRICE=10000

## Safety Features

# Dry run mode (simulate but don't execute)
DRY_RUN=true                      # Set false for live trading!

# Require confirmation before executing large trades
REQUIRE_CONFIRMATION_ABOVE_SOL=5.0

# Auto-pause on suspicious activity
AUTO_PAUSE_ON_ANOMALY=true

## Notes

# BEFORE GOING LIVE:
# 1. Set DRY_RUN=false
# 2. Use premium RPC (Triton/Helius)
# 3. Start with small MAX_TRADE_SIZE_SOL (1-2 SOL)
# 4. Monitor for 24 hours before scaling
# 5. Set up alerts/monitoring

# PROFIT CALCULATION FORMULA:
# Net Profit = (Sell Price - Buy Price)
#            - Transaction Fees
#            - Protocol Fees (DEX-specific)
#            - Priority Fees
#            - Slippage (both sides)
#
# Only execute if: Net Profit > MIN_PROFIT_SOL AND > MIN_PROFIT_PERCENT
